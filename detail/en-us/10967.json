{
  "epId": 10967,
  "name": "Sandrone's Portable Tea Table",
  "desc": "A portable tea table gifted to you by Sandrone. Easy to carry and store, and even fitted with a levitation device. With this, you can enjoy a leisurely tea party almost anywhere.",
  "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/06/29/8fa465ce5018dc6fb89ca4636f28e12c_4605284369813192294.png",
