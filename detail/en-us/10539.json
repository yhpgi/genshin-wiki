        "imgDesc": [
          {
            "type": "RichText",
            "text": "In certain areas, you will sometimes encounter these wondrous Harpasta imbued with the Authority of Space. After interacting with them, you can transform briefly into a Plume Moth. In this form, you <color=#ffe04b>can continuously accelerate through the air</color> by <color=#ffe04b>holding Sprint or the Ascend button</color> ."
          }
        ]
      },
      {
        "key": "Page 2/3",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/06/16/236056902/3f7bd68f5ed5c994f5b45f9f566b0cb3_2187033128160284320.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "When sprinting or increasing altitude, the Plume Moth's stamina will be consumed continuously. When flying through Wind Rings, your flying speed will increase temporarily."
          }
        ]
      },
      {
        "key": "Page 3/3",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/06/16/236056902/48a836dd80cf2cbf1484cd08b8bef737_7963912576172570191.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "When coming into contact with the special Bellowing Harpastum, you will fly a fixed distance in a set direction."
          }
        ]
      }
