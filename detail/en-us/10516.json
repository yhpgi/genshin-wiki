        "epId": 10617,
        "name": "Josephus",
        "desc": "<p>\"Great master of anti-self-termination,\" who lived right after the War of Funerary Flame.</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/04/13/237301566/f0a6c5fd668b26bc94cc21d31e8959bf_7221577266537080197.png",
