        "imgDesc": [
          {
            "type": "RichText",
            "text": "Within the Temple of Space, you will sometimes find paintings that have pockets of space sealed inside them.\nBy <color=#ffe04b>overlapping</color> the image in the painting with the corresponding scene in reality, Dex can <color=#ffe04b>restore</color> the space trapped within the painting and manifest objects from the painting into the physical world."
          }
        ]
      },
      {
        "key": "Page 2/3",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/05/31/236056902/9a3f881c4b196aa33ce4d4ea6862b584_1023044301199614708.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "The closer the painting is to the actual scene, the brighter the light emitted by the frame will be."
          }
        ]
      },
      {
