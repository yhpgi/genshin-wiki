    "story": [
      {
        "desc": [
          {
            "type": "RichText",
            "text": "Tahta, kemik ve hayvan tendonlarından yapılmış, ince işçilik eseri bir eğri yay.\nUsta bir okçunun ellerindeyken, havadaki kartalları kolayca vurabilirmiş.\nBu yay, bir avcının gururu ve becerilerinin vücut bulmuş haliymiş.\nZavallı masum kartallar."
          }
        ]
      }
    ],
