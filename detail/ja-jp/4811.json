      {
        "key": "アル・ヌハスの都",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/05/01/75248538/5768dad698b6da52106479457bccb39a_5228023431138218168.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "カーンルイアの兵器実験施設\n（スメール）"
