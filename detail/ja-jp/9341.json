      {
        "type": "CustomEntry",
        "epId": 8778,
        "name": "怪盗レッド・ミラーの伝説",
        "desc": "",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/09/01/03a8b4d8dffddbcfa26acf7e7aaba6ab_4182482964320066280.png",
        "displayStyle": "card",
        "menuId": 12
      },
      {
        "type": "CustomEntry",
        "epId": 9216,
        "name": "シルバーランプの芯",
        "desc": "結界を展開できる神聖なランプ。エネルギーに満ち溢れ、煌々と輝きを放っている。<br>本来は霜月の子の祭器であり、かつて失楽の荒土をさまよう古国の遺民たちに夢と詩をもたらした。時の流れが止まっている「塔」に残されていたことで、その姿は今日まで損なわれることなく保たれている。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/01/12/1704751378286183a6b37d3025063137_8580353893545905918.png",
        "displayStyle": "card",
        "menuId": 9
      }
    ]
