  "components": {
    "textualResearch": [
      {
        "title": "チュートリアル1",
        "desc": [
          {
            "type": "RichText",
            "text": "<color=#ffe14b>「メメント写真機」</color> を装備した状態で、撮影ポイントにインタラクトする、またはキャラクターと会話することで撮影モードに入ります。"
          }
        ]
      },
      {
        "title": "チュートリアル2",
        "desc": [
          {
            "type": "RichText",
            "text": "撮影中、 <color=#ffe14b>カラーフィルターレンズ</color> のプレビューと設定ができます。挑戦をクリアした後、結果画面でも <color=#ffe14b>カラーフィルターレンズ</color> を調整可能です。"
          }
        ]
      },
      {
        "title": "チュートリアル3",
        "desc": [
          {
            "type": "RichText",
            "text": "一部の風景ステージでは、動物や植物とインタラクトし、適切な撮影状態に調整する必要があります。"
          }
        ]
      },
      {
        "title": "チュートリアル4",
        "desc": [
          {
            "type": "RichText",
            "text": "一部の風景ステージでは、 <color=#ffe14b>撮影位置と撮影角度</color> を確認し、適切な撮影状態に調整する必要があります。"
          }
        ]
      },
      {
        "title": "チュートリアル5",
        "desc": [
          {
            "type": "RichText",
            "text": "キャラクターステージでは、 <color=#ffe14b>キャラクターのポーズを調整</color> でき、適切なタイミングで <color=#ffe14b>一時停止</color> することも可能です。ポーズを調整した後に写真を撮ると、 <color=#ffe14b>挑戦成功</color> となります。"
          }
        ]
      },
      {
        "title": "チュートリアル6",
        "desc": [
          {
            "type": "RichText",
            "text": "撮影ポイントには、それぞれ3つの撮影ポジションがあり、撮影ポジションごとに撮影の角度と写真のサイズが異なります。"
          }
        ]
      },
      {
        "title": "チュートリアル7",
        "desc": [
          {
            "type": "RichText",
            "text": "キャラクターステージでも <color=#ffe14b>カラーフィルターレンズ</color> を調整できます。"
          }
        ]
      }
    ],
