      {
        "type": "CustomEntry",
        "epId": 8979,
        "name": "水形タルパ",
        "desc": "<p><strong>目覚めた生命・水形タルパ</strong></p><p></p><p>無数の水滴が凝縮して産み出された、人の胚子のような姿を持つ魔物。</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/11/08/224893084/e1b23bd295d6daa4e3d6c8d3e9e80478_8512846684531763294.png",
