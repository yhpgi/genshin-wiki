      {
        "title": "拍手に霞む",
        "desc": [
          {
            "type": "RichText",
            "text": "「技術的には完璧な公演でしたが、自分を見失ってしまいましたわ。」"
          }
        ]
      },
      {
        "title": "静かな湖に独り舞う",
        "desc": [
          {
            "type": "RichText",
            "text": "「私は自分らしく生きることを決心しました…相応の代償を払って。」"
          }
        ]
      },
      {
        "title": "雪の夜はいまだ明けず",
        "desc": [
          {
            "type": "RichText",
            "text": "「望むものはあまりにも多く、成し遂げられるものはあまりにも少ない。それでも私は、嘆きも諦めもしません。前へ進み続けるのみです。」"
          }
        ]
      },
      {
        "title": "黎明",
        "desc": [
          {
            "type": "RichText",
            "text": "「遅れて灯されたスポットライトには、幼い頃と同じ温もりがありました。」"
          }
        ]
      },
      {
        "title": "空虚な日々",
        "desc": [
          {
            "type": "RichText",
            "text": "「私は一体、何をしていたのでしょう…」"
          }
        ]
      }
