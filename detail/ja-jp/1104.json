      {
        "type": "CustomEntry",
        "epId": 1307,
        "name": "米",
        "desc": "テイワットで特に見られる作物。何度食べても飽きない、空腹を満たしてくれる最高の食材。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Rice_icon.png",
