      },
      {
        "type": "CustomEntry",
        "epId": 1048,
        "name": "清心",
        "desc": "断崖絶壁にしか咲かない透き通る白い花。平原の温もりと潤いよりも冷たい高い場所を選ぶ花。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Qingxin_icon.png",
