      {
        "type": "CustomEntry",
        "epId": 873,
        "name": "無主のスターライト",
        "desc": "ショップでレアなものと交換できるコイン。<br/>過剰な運命の星の光。その輝きは宇宙の至るところを照らせるかもしれない。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Masterless Starglitter_icon.png",
        "displayStyle": "text"
      },
      {
        "type": "RichText",
        "text": "5個と交換する\n1個"
      },
      {
        "type": "CustomEntry",
        "epId": 872,
        "name": "無主のスターダスト",
        "desc": "ショップでレアなものと交換できるコイン。<br/>過剰な運命の星のダスト。積もれば新たな運命を切り拓けるかもしれない。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Masterless Stardust_icon.png",
        "displayStyle": "text"
      },
      {
        "type": "RichText",
