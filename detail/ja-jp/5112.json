      {
        "type": "CustomEntry",
        "epId": 71,
        "name": "「冷製鮮肉」",
        "desc": "珍しい鮮肉類。<br/>数百年前に絶滅した品種で、ドラゴンスパインの気候により保存された。テイワットの美食家にとって、信仰の対象に等しい極上の食材。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Chilled Meat_icon.png",
        "displayStyle": "card"
