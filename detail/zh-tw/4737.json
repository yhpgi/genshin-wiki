      {
        "key": "相關角色",
        "value": [
          {
            "type": "CustomEntry",
            "epId": 2238,
            "name": "雷音權現",
            "desc": "異常的雷元素生命。雖然外貌上與純水精靈有相似之處，卻不具備她的智慧與記憶。<br/>驅動雷音權現的是更為原始純粹的憤怒。<br/>據說這種生物只會隨著雷霆降生在遺留著強大忿恨的地方，譬如說支離破碎、雷雲黝黝的天雲峠。只要土地中的怨恨不消，那雷鳴也不會斷絕吧。",
            "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/enemy/Thunder Manifestation_icon.png"
          }
        ],
        "isMaterial": true
      },
