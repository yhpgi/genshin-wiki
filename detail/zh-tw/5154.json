{
  "epId": 5154,
  "name": "那維萊特",
  "desc": "<p><span style=\"color: rgb(255, 255, 255)\">諭告的潮音 · 那維萊特</span></p><p>凡高大者，無不蔑視。</p>",
  "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/06/12/125391187/b3e02e0cb0cf8f5d1f3510f4f3014bb3_1667441595706154924.png",
