{
  "epId": 7820,
  "name": "茜特菈莉",
  "desc": "<p><span style=\"color: rgba(255,255,255,1)\">白星黑曜 · 茜特菈莉</span></p><p>謎煙流彩，曜石映心。</p>",
  "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/04/13/84496276/f3f4dbae5d7108bb59679abe93f88322_8745535763283632601.png",
