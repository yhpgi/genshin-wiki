    "summaryList": [
      {
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/08/11/04df6c4e3e16bc388e26f36763446ff3_6887530942789749080.png",
        "name": "漸肅的凝冰",
        "desc": [
          {
            "type": "RichText",
            "text": "旅行者造成了星爍反應傷害時，將為自身恢復5點元素能量，此效果至多每0.5秒觸發1次。"
          }
        ]
      },
      {
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/08/11/1d38e719233feeaa2f5e0ccfef150d57_2287606918801940715.png",
        "name": "嗡鳴的隕冰",
        "desc": [
          {
            "type": "RichText",
            "text": "元素戰技 <color=#ffd780>冰霧劍</color> 發射的 <color=#ffd780>冰晶</color> 命中敵人後，還會使目前場上角色的元素精通提升60點，持續5秒。\n此外，若受到上述效果影響的角色觸發了星爍反應，或造成了星爍反應傷害，則持續時間內，上述效果改為提升120點元素精通。"
          }
        ]
      },
      {
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/08/11/fe78f3329f1fba1ceedf4525d4e98360_4733887423580012124.png",
        "name": "斷金的銳冰",
        "desc": [
          {
            "type": "RichText",
            "text": "元素爆發 <color=#ffd780>聚冰成鋒</color> 的技能等級提高3級。\n至多提升至15級。"
          }
        ]
      },
      {
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/08/11/7c4f861ed668ba3030cae77db66a6913_1701404904928541117.png",
        "name": "不化的頑冰",
        "desc": [
          {
            "type": "RichText",
            "text": "元素戰技 <color=#ffd780>冰霧劍</color> 創造的 <color=#ffd780>栗烈寒星</color> 存在時間延長25%。"
          }
        ]
      },
      {
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/08/11/bf6fe0588cb5c31d981c23faf977e0bb_1406077280300974790.png",
        "name": "深寒的霧冰",
        "desc": [
          {
            "type": "RichText",
            "text": "元素戰技 <color=#ffd780>冰霧劍</color> 的技能等級提高3級。\n至多提升至15級。"
          }
        ]
      },
      {
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/08/11/d44d55b0d68b6f60bc83e6ee2c5272df_1026591120137102844.png",
        "name": "肅殺的熙冰",
        "desc": [
          {
            "type": "RichText",
            "text": "施放元素爆發 <color=#ffd780>聚冰成鋒</color> 時，每消耗1層 <color=#ffd780>寒輝</color> ，隊伍中其他角色造成的星爍反應傷害提升5%，至多依此方式提升40%，持續15秒。"
          }
        ]
      }
