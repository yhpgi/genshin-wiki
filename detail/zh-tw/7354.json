    "story": [
      {
        "title": "月之五「捕風的歸客」",
        "desc": [
          {
            "type": "RichText",
            "text": "● 角色牌「克洛琳德」的天賦牌「破夜的明焰」增加了月感電相關描述或效果判定。"
          }
        ]
