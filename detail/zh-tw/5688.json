    "talent": [
      {
        "key": "旋尾迅擊",
        "title": "旋尾迅擊",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/08/25/125391187/47817b4476bcd8b44c86c87debf042f2_7096527193030219036.png",
