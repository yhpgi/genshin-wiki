      {
        "type": "CustomEntry",
        "epId": 4739,
        "name": "Azhdaha",
        "desc": "<p><strong><span style=\"color: #FFFFFF\">Azhdaha - Ancestro de los Dragartos</span></strong></p><p>El tintineo de los grilletes que aprisionan al dragón y sus profundos gruñidos resuenan en el interior de la montaña como los recuerdos de un tiempo pasado.</p>",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2023/12/15/59c9f48b45fef7fae67645f57f3631bc_3076907361622382292.png",
        "displayStyle": "card",
        "menuId": 17
