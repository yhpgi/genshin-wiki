      {
        "type": "CustomEntry",
        "epId": 4095,
        "name": "Plano: Réquiem Abisal",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Un diseño de arma bosquejado por Estelle según la información descrita en antiguas leyendas y otros documentos. Tras obtenerlo, podrás reproducir la espada ligera “Réquiem Abisal”.</span></p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/08/25/10742394/de7bbf87f6037a86ca275ce9fedd8168_5194456507953252318.png",
        "displayStyle": "text"
      },
      {
        "type": "CustomEntry",
        "epId": 4098,
        "name": "Burburanja",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Una fruta que crece en entornos cálidos y húmedos, pero con abundancia de sol. Bajo su redonda piel, se esconde un dulce fruto de refrescante sabor.</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/01/09/10742394/8591cb57f4fd6c4c8d430a23eaf8cbc4_7937657544131701556.png",
        "amount": 10,
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 4005,
        "name": "Marealga",
