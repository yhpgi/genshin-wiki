      {
        "type": "CustomEntry",
        "epId": 3178,
        "name": "Mona",
        "desc": "<p><strong><span style=\"color: #FFFFFF\">Mona - La Observadora de los Astros</span></strong></p><p>Ganes o pierdas, todo está escrito en las estrellas.</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/12/05/248396192/2c2d8a83c9a5a9a97531fee1491efa85_7118438406712920127.png",
