        "alignment": "center"
      },
      {
        "type": "CustomEntry",
        "epId": 5685,
        "name": "Kaveh",
        "desc": "<p><strong><span style=\"color: #FFFFFF\">Kaveh - El Espejo del Empíreo</span></strong></p><p>Arte de la comprensión, la benevolencia y la estética.</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/06/09/73555894/115807e57a8e6af6408e25c134e79efb_8620031370621933340.png",
