        "name": "Furina",
        "desc": "<p><strong><span style=\"color: #FFFFFF\">Furina - La Bailarina Incansable</span></strong></p><p>Solista eterna, bailarina infinita.</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/06/09/73555894/c9f3acfbdfdf016c5d25ddb4d00dd09c_2545100058887450476.png",
