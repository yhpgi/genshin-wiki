      {
        "type": "CustomEntry",
        "epId": 4072,
        "name": "Engranaje de malla",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">El engranaje de un Mecabot.<br>Un componente necesario para el sistema motriz. En cuanto se pierde, las funciones a las que da uso se inhabilitan por completo.</span></p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/08/16/10742394/0d15f8ce2c281306fbc8e0c3a6315437_6235014788396882492.png",
