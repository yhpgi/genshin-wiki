      {
        "type": "CustomEntry",
        "epId": 3844,
        "name": "Hipóstasis electro",
        "desc": "<p><strong><span style=\"color: rgb(255, 255, 255)\">Hipóstasis electro</span></strong></p><p><span style=\"color: rgba(255, 255, 255, 0.65)\">Nombre en clave: Álef. Un ser Electro de gran pureza.</span></p><p><span style=\"color: rgba(255, 255, 255, 0.65)\">Aunque le ganes a piedra, papel, tijera, nunca admitirá la derrota.</span></p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/05/24/73555894/a18a61786bc99b67ad9fde145786cbe3_531044834597770906.png",
