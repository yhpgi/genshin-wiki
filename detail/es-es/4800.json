      {
        "type": "CustomEntry",
        "epId": 4738,
        "name": "Dvalin",
        "desc": "<p><strong><span style=\"color: #FFFFFF\">Dvalin - Dragón del Este</span></strong></p><p>“Si fueras yo, si te hubieras visto surcando el cielo azul con tu hermosa silueta...Así entenderías que vale la pena luchar por este cielo y esta tierra”.</p>",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2023/12/15/497160d9f34a61f72b6943c550530da9_1244295654152502150.png",
