      {
        "type": "CustomEntry",
        "epId": 3175,
        "name": "Kaeya",
        "desc": "<p><strong><span style=\"color: #FFFFFF\">Kaeya - El Espadachín Glacial</span></strong></p><p>Especialista en despertar las “virtudes caballerescas” en otros.</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/12/05/248396192/a4641f3c8a186e2948662aa255638a9c_7947872288946400988.png",
