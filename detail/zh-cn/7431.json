      {
        "type": "CustomEntry",
        "epId": 2019,
        "name": "西风猎弓",
        "desc": "西风骑士团的制式反曲弓，只有杰出的弓手能与它的杰出性能相衬。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/weapon/西风猎弓.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
        "type": "CustomEntry",
        "epId": 2021,
        "name": "西风长枪",
        "desc": "西风骑士团的制式长枪。枪杆直挺，枪尖轻风流溢。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/weapon/西风长枪.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
        "type": "CustomEntry",
        "epId": 2033,
        "name": "钟剑",
        "desc": "装有时钟的厚重大剑，其中的计时机关早已被破坏。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/weapon/钟剑.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
        "type": "CustomEntry",
        "epId": 3999,
        "name": "狼牙",
        "desc": "<p>传说中，遥远过去的流浪骑士所使用的长剑。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/08/16/47826599/fcb69a6f01bb2be8bb0abd2f67a9d887_3717439876010328690.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
        "type": "CustomEntry",
        "epId": 2037,
        "name": "铁影阔剑",
        "desc": "这把剑是著名的光之狮艾伦德林的佩剑的仿品。握紧它，感受传说中大英雄的力量吧！注意：幻想请适度。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/weapon/铁影阔剑.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
        "type": "CustomEntry",
        "epId": 2077,
