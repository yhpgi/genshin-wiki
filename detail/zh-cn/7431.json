        "epId": 2018,
        "name": "西风大剑",
        "desc": "西风骑士团的重型仪式剑。能轻易导出元素力量，具有卓越的破坏力。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/weapon/西风大剑.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
        "type": "CustomEntry",
        "epId": 2020,
        "name": "西风秘典",
        "desc": "西风骑士团的学者间流传的秘典，记载着元素与物质的道理和力量。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/weapon/西风秘典.png",
