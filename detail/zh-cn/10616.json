        "alignment": "center"
      },
      {
        "type": "CustomEntry",
        "epId": 5576,
        "name": "白夜国",
        "desc": "<p>「原初的那一位」与天上的「第二个王座」大战之际，落入暗之外海的古老文明。</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/09/13/142453215/d9249cfe7e91d27caa52bdb7121ed2c4_7142651148786861228.png",
