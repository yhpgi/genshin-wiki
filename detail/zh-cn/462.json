      {
        "type": "CustomEntry",
        "epId": 1361,
        "name": "绯樱天妇罗",
        "desc": "油炸而成的菜肴。将腌制好的绯樱花瓣拌入面浆中，再把新鲜的虾和蔬菜均匀裹上面衣，炸制沥干油分。看似简单，但想做出足够惊艳的天妇罗，却非一朝一夕就能练成。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Sakura Tempura_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 559,
        "name": "奇怪的绯樱天妇罗",
        "desc": "油炸而成的菜肴。或许是对油温控制的生疏。食材刚入锅的时候，便冒出了刺鼻的烟。成品的面衣斑驳而焦黄，虽然很可惜…要不还是别吃了吧。",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/04/09/88072335/9819a519d3763bc6705708871f56262a_364168706078378600.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 1438,
        "name": "美味的绯樱天妇罗",
        "desc": "油炸而成的菜肴。面衣又薄又透，仿佛给食材穿上了一层华贵的纱衣。入口的酥脆与内里的鲜嫩形成了绝妙的层次，让人不禁探究这浑然天成的美味究竟是如何而生。",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/04/09/88072335/a18d160ff4d4a8d8a3e421fe9522020d_7904301594393208652.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 190,
        "name": "「静寂闲雅」",
        "desc": "神里绫人的特色料理。摆盘精致典雅，照应绫人本人的处事风格，多一分是盈，少一分则亏。细细品尝，味道居然和乌有亭一模一样，真是奇妙。最后将筷子伸向那朵晶莹的椿花时，却被绫人拦了下来…「那是练剑时的顺手之作，只是个装饰品。」",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Quiet Elegance_icon.png",
        "displayStyle": "card"
      }
    ]
