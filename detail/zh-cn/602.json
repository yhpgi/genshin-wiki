      },
      {
        "type": "CustomEntry",
        "epId": 1737,
        "name": "面粉",
        "desc": "由小麦磨成的粉末。无论做成怎样的主食，都能给食客的胃带来片刻充实。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Flour_icon.png",
