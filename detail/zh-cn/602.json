      {
        "type": "CustomEntry",
        "epId": 6334,
        "name": "食谱：奶油炖鸡",
        "desc": "<p>步骤详实的食谱，记载着「奶油炖鸡」的制作方法。</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/08/12/157749474/955d23a38b8e91a5e5c9de7547d7a320_6540462913462030313.png",
