{
  "epId": 5721,
  "name": "食谱：桔香鸭胸肉",
  "desc": "<p>步骤详实的食谱，记载着「桔香鸭胸肉」的制作方法。</p>",
  "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/03/28/326985891/60c9c277139b43907167e6452d409874_6833199190133313221.png",
