      },
      {
        "type": "CustomEntry",
        "epId": 4098,
        "name": "泡泡桔",
        "desc": "<p><span>生长在温暖、湿润、光照充足之处的果实，圆圆的外表下，偷偷藏着甜甜的甘鲜。</span></p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/09/05/88072335/6cf3c48d4c41e5ac44723725064d3f85_6662973587425858896.png",
        "amount": 1,
        "displayStyle": "card",
        "menuId": 9
      },
      {
