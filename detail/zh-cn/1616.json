      {
        "type": "CustomEntry",
        "epId": 1616,
        "name": "豆腐",
        "desc": "鲜嫩的豆制品。口感如凝乳般细腻。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Tofu_icon.png",
