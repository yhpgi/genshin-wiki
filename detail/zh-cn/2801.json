        "menuId": 10
      },
      {
        "type": "CustomEntry",
        "epId": 2820,
        "name": "关于你与兰那罗的故事",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">与兰那罗一同冒险的过程中，产生了许许多多的奇妙故事。在重视故事的兰那罗世界里，或许有谁愿意进行「交换」吧。</span></p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/09/27/36540823/fc846e5a1e69eed303041501122d9752_5374521376043540457.png",
