      {
        "type": "CustomEntry",
        "epId": 3925,
        "name": "兰随尼",
        "desc": "<p>在「玛哈桓那兰那薜那」发现的一只兰那罗。兰随尼会用锻造图纸来交换故事。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/07/10/88072335/b715877a58768536adf2136128c1a81f_7383751716847155830.png",
