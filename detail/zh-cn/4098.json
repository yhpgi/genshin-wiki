      {
        "type": "CustomEntry",
        "epId": 1328,
        "name": "糖",
        "desc": "提炼自甜甜花的调味剂。它的甜味仿佛有着与人共鸣的力量，能够驱散内心的阴霾。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Sugar_icon.png",
        "amount": 2,
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "CustomEntry",
        "epId": 921,
        "name": "杏仁",
        "desc": "有着奇特香味的种子。能给食物带来全然不同的清新风味。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Almond_icon.png",
        "amount": 2,
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "CustomEntry",
        "epId": 4098,
        "name": "泡泡桔",
        "desc": "<p><span>生长在温暖、湿润、光照充足之处的果实，圆圆的外表下，偷偷藏着甜甜的甘鲜。</span></p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/09/05/88072335/6cf3c48d4c41e5ac44723725064d3f85_6662973587425858896.png",
