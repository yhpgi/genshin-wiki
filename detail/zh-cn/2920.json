      {
        "type": "CustomEntry",
        "epId": 163,
        "name": "「自由」的指引",
        "desc": "天赋培养素材。<br/>风之国土的精神是自由。<br/>自由其二，是漫游的自由，即是能在苍翠的土地上自由地通行，而不受阻挠的自由。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Guide to Freedom_icon.png",
        "amount": 5,
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "CustomEntry",
        "epId": 1878,
        "name": "高塔孤王的残垣",
        "desc": "赋予武器突破之力的材料。<br/>烈风的魔神「迭卡拉庇安」对自己所造的王城十分满意，他在高塔上接受所有追随者的跪拜。但他却不知道，众人对他俯身并非出于敬仰爱戴。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Debris of Decarabian's City_icon.png",
        "amount": 5,
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "RichText",
        "text": "节庆热度达到400"
      },
      {
        "type": "CustomEntry",
        "epId": 2856,
        "name": "迁风的苍翎",
        "desc": "<p>「风信之锋」专用的精炼道具。</p><p>由松石雕而成的古旧羽翮，在过去似乎曾被用作饰品或信物。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/09/30/47826599/68802a3705c4144acbdd523805f5fa49_4169480492370652642.png",
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "CustomEntry",
        "epId": 757,
        "name": "摩拉",
        "desc": "通行大陆的钱。世界通用的共同语言，谁人都能理解的贵金属。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Mora_icon.png",
