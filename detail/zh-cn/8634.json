      {
        "type": "CustomEntry",
        "epId": 8632,
        "name": "黑麦粉",
        "desc": "碾碎黑麦后得到的粗糙、深色粉末。用其制作出的食物拥有独特的口感与酸味。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/09/01/ea2d344acd818226a104e96e0d1bab44_2842035318907288483.png",
        "amount": 2,
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "CustomEntry",
        "epId": 8630,
        "name": "酸奶油",
        "desc": "经分离发酵等复杂工艺后得到的奶制品。具有柔滑的质地与清爽的酸味，是许多菜肴中的点睛之笔。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/09/01/47e5977ffd99ab900468ab2c2e370ad2_8362660603897011876.png",
