        "alignment": "center"
      },
      {
        "type": "CustomEntry",
        "epId": 757,
        "name": "摩拉",
        "desc": "通行大陆的钱。世界通用的共同语言，谁人都能理解的贵金属。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Mora_icon.png",
        "amount": 125,
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 2708,
        "name": "休眠菌核",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">蕈兽的部分身体组织，在外界元素的剧烈刺激下才会形成。</span></p><p><span style=\"color: rgba(255, 255, 255, 0.65)\">生论派的学者们曾对蕈兽究竟属于植物还是动物展开过旷日持久的论战。最后两派达成和解，将蕈兽单列在动植物之外，并不再讨论。</span></p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/08/31/36540823/88f08ae70e49d226bd37fd54a97c65f3_3676702223524448941.png",
