      {
        "type": "CustomEntry",
        "epId": 1406,
        "name": "美味的月亮派",
        "desc": "蒙德的传统主食。切开娇小肉派的一角，黄油奶香伴随着丰富肉香一同涌入鼻腔。扎实香甜的口感更是令人回想起那些与节日、丰收相关联的景象，不自觉洋溢起幸福的笑容。",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/03/25/88072335/2234d75f6d083a9a169723b7e65f1d03_9083558142178065402.png",
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "CustomEntry",
        "epId": 906,
        "name": "月亮派",
        "desc": "蒙德的传统主食。腌制过的肉类不仅风味浓郁，经过酥皮的烘烤后，更保持了香甜与湿润。是蒙德节日不可缺少的组成部分。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Moon Pie_icon.png",
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "RichText",
        "text": "<color=#ffffff>相关角色 / 特色料理</color>"
      },
      {
        "type": "CustomEntry",
        "epId": 6,
        "name": "优菈",
        "desc": "古老家族出身的「浪花骑士」，西风骑士团游击小队队长。身为旧贵族后裔却加入了堪称死对头的西风骑士团，该事件至今仍是蒙德一大谜团。",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/05/22/327628065/d2201d00f4b88d1701d3e70701e73bc4_97528772977352915.png",
        "displayStyle": "card",
        "menuId": 2
      },
      {
        "type": "CustomEntry",
        "epId": 1874,
        "name": "骇浪派",
        "desc": "优菈的特色料理。不同于圆月的造型不知是在反抗传统，还是表达她「以牙还牙」的行事作风。金黄外皮之下，咸鲜的烟熏风味饱满浓郁，全蒙德也难找到第二个能做出如此美味的人…但要是这样说出口的话，恐怕又会被她「记仇」了吧。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Stormcrest Pie_icon.png",
        "displayStyle": "card",
        "menuId": 9
      }
    ],
