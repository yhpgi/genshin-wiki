      {
        "type": "CustomEntry",
        "epId": 948,
        "name": "果酿饵",
        "desc": "十分常见的鱼饵，由日落果与小麦捣碎发酵揉制而成，入水后能够快速雾化，对小型鱼类有着强烈的吸引力。由于其制作简单、价格低廉、效用优秀，因此又被戏称为「钓鱼佬宝珠」。<br/><br/>适用鱼种：鳉鱼类。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Fruit Paste Bait_icon.png",
        "amount": 10,
        "displayStyle": "card"
      },
      {
        "type": "CustomImage",
        "url": "https:/upload-static.hoyoverse.com/hoyolab-wiki/2023/01/04/35428890/405e199979d710b4db5c640cccabd66b_6301407142072940114.png",
        "alignment": "center"
      },
      {
        "type": "CustomEntry",
        "epId": 883,
        "name": "日落果",
        "desc": "遍布提瓦特大陆的自然恩惠，如夕阳般靓丽美好的饱满果实。有着奇异的香甜气味，能让人精神百倍。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Sunsettia_icon.png",
        "amount": 1,
        "displayStyle": "card"
      },
