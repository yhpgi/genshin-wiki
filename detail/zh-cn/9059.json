    "textualResearch": [
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「请放心吧，永远有下一段旅途在等着你们。」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「请放心吧，永远有下一段旅途在等着你们。」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「…能给我几个还没有充气的气球吗？」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「希望我们能在下个节日再次相遇！」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「…输了的话，信不信我把你头打爆。」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「谢谢你，多莉老板，我玩得很愉快。」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「什锦口味祈月糖，满满一盒装！」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「不要再狡辩了，伊涅芙！」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「不要再狡辩了，伊涅芙！」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「希望月下世界的人们都能寻到自己的归宿，希望将来能和朋友们再次相见。」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「明明自己的那份少了，但心里却像被另一种东西填满了一样。」"
          }
        ]
      },
      {
        "desc": [
          {
            "type": "RichText",
            "text": "「明明自己的那份少了，但心里却像被另一种东西填满了一样。」"
          }
        ]
      }
    ]
