      },
      {
        "type": "CustomEntry",
        "epId": 499,
        "name": "奇怪的冷肉拼盘",
        "desc": "摆满肉类的拼盘。似乎做得太冷了一点，可能对牙齿和肠胃不好的人而言是一种折磨。",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/04/10/88072335/05480110c2fac68671fe5dc2f6f26ec6_8930581222091778439.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 1382,
        "name": "美味的冷肉拼盘",
        "desc": "摆满肉类的拼盘。绝妙的调味激发了食材的鲜香，三种肉类的组合在嘴里拼接成了至高的美味，令人顿时忘记烦恼。",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/04/10/88072335/90b53ff37b5fa5e524ee630ce62ba2e9_3762201663860572479.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 1260,
        "name": "祝圣交响乐",
        "desc": "菲谢尔的特色料理。精美的摆盘中似乎传言着某种不为人知的深奥。如果在享受美味的同时看向菲谢尔的话，能透过她半遮脸庞的指尖看到她期待的眼神…这也是秘密的一部分吗？",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Die Heilige Sinfonie_icon.png",
        "displayStyle": "card"
