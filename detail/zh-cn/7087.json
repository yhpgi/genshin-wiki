      },
      {
        "type": "CustomEntry",
        "epId": 1013,
        "name": "浓缩树脂",
        "desc": "同时最多持有5个。<br/>能在激活石化古树与地脉之花时替代原粹树脂，以获得更丰厚的宝藏的树脂浓缩产物。<br/>蕴含着充沛能量的晶体。<br/>银白的古树与花连接着地脉，而树脂蕴含的能量能疏通地脉的管道，提炼淤滞其中的物质。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Condensed Resin_icon.png",
        "displayStyle": "card",
