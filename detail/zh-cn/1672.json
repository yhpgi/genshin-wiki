      {
        "type": "CustomEntry",
        "epId": 491,
        "name": "奇怪的串串三味",
        "desc": "组合而成的串串。发黑的竹签串着黯淡的食材，散发着说不上来的古怪气味，在野外食用的话，说不定会吸引丘丘人…",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/03/17/88072335/59afc49211b18648c83f515064bd1994_7357980363838853614.png",
