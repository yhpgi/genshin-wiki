        "url": "https:/act.hoyolab.com/ys/app/interactive-map/index.html?bbs_presentation_style=no_header&utm_source=hoyolab&utm_medium=tools&lang=zh-cn&bbs_theme=light&bbs_theme_device=1#/map/9?shown_types=55&center=-1.50,-77.00&zoom=-0.50"
      },
      {
        "type": "RichText",
        "text": "<color=#ffffffd9>远古圣山：</color>"
      },
