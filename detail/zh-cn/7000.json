      {
        "type": "CustomEntry",
        "epId": 6551,
        "name": "木棉之环",
        "desc": "昔日的双生英杰锻造的玉器，传说曾将盘踞火山的巨龙从天穹击坠。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2024/08/23/9ab70898644274ce31f91faea8216bd8_5924884446177979679.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
        "type": "CustomEntry",
        "epId": 7028,
        "name": "弥坚骨",
        "desc": "在千万次敲打和挥舞中变得越发坚硬的骨制长剑，据传曾是英杰万杰鲁趁手的武器。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2024/09/27/9fbe8cf3da1d476d4c5a228017656cd1_114889972255186755.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
        "type": "CustomEntry",
        "epId": 7588,
        "name": "溢彩心念",
        "desc": "由沃陆之邦的宝石与花羽会的水晶锻造而成的奖杯，据说曾属于某位传奇的摔角手。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/03/17/4eed5f1f892cf722e4f8df1778a0a1f1_3249018324800310475.png",
