      {
        "type": "CustomEntry",
        "epId": 963,
        "name": "桦木",
        "desc": "产自「桦树」的木材，易于加工，切面光滑，用这种木材制作的家具器物大多美观而耐用。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Birch Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 1522,
        "name": "萃华木",
        "desc": "产自「萃华树」的木材，色泽秀美，木质独特，经过适当的加工，能胜任各种用途。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Cuihua Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 933,
        "name": "松木",
        "desc": "产自「松树」的木材，色泽与木纹并不亮眼，但以朴实无华、低调素雅著称。且木质坚实，只需老练的木匠处理，就能耐受虫蛀和腐蚀。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Pine Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 364,
        "name": "却砂木",
        "desc": "产自「却砂树」的木材，据说有着风雨不侵，百年不朽的卓越木质。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Sandbearer Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 1316,
        "name": "竹节",
        "desc": "翠竹的竹段，轻巧而结实，远比谦逊的外表坚韧，散发着独特的清幽气息。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Bamboo Segment_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 450,
        "name": "垂香木",
        "desc": "产自「苍柏」的木材，因其富含油脂，香气别致，有着「垂香木」的别称。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Fragrant Cedar Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 920,
        "name": "杉木",
        "desc": "「冷杉」出产的木材，有着不错的木质和纹理，被广泛使用于各种领域。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Fir Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 966,
        "name": "梦见木",
        "desc": "产自「樱树」的木材，质感细腻，富含水分，据说能为人们带来暖春般的美梦。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Yumemiru Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 950,
        "name": "枫木",
        "desc": "产自「羽扇枫」的木材，硬度适中，品质优异，色泽与纹理上佳。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Maple Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 608,
        "name": "孔雀木",
        "desc": "「柳杉」出产的木材，质地柔软，纹理平直，散发着浅淡的清香。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Aralia Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 712,
        "name": "御伽木",
        "desc": "「御伽树」出产的木材，水分和油脂的含量恰到好处，因此有着各种用途。<br/>可用于制作摆设。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Otogi Wood_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 3679,
        "name": "辉木",
        "desc": "<p>产自「辉树」的木材，似乎有着与普通木材不同的构造，质地较软，但极为坚韧，易于染色，用途较为特别。</p><p>可用于制作摆设。</p>",
