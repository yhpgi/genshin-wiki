      },
      {
        "type": "CustomEntry",
        "epId": 1077,
        "name": "火腿",
        "desc": "经过熏制的腿部兽肉。薄薄的一片就能带来满嘴的芳香。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Ham_icon.png",
        "amount": 1,
        "displayStyle": "card"
      },
      {
        "type": "RichText",
