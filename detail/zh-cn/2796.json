      },
      {
        "type": "CustomEntry",
        "epId": 2746,
        "name": "食谱：雨林沙拉",
        "desc": "<p>步骤详实的食谱，记载着「雨林沙拉」的制作方法。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/03/07/88072335/60c9c277139b43907167e6452d409874_5556423360945389375.png",
