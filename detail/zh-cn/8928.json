      {
        "type": "CustomEntry",
        "epId": 8720,
        "name": "镌识者的鸦翎",
        "desc": "如夜幕般漆黑的鸦羽，据说是盗宝团的创立者雷德·米勒留下的信物。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/09/01/80342508a3ddc5782f47c8bf3d087f11_2726327161650599153.png",
