      {
        "type": "CustomEntry",
        "epId": 6831,
        "name": "火之寻宝罗盘",
        "desc": "在纳塔使用时，能寻找附近的宝箱。<br>火之国土的大地之上遍布纷争，有许多因此失去了线索与踪迹的宝藏。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2024/08/23/179ba79ed6543270d33663fe47a1fc22_4623599261289267899.png",
        "displayStyle": "card",
