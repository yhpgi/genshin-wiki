      {
        "type": "CustomEntry",
        "epId": 260,
        "name": "什锦炒面",
        "desc": "稻妻的家常料理之一。只需要把面与配菜均匀炒熟就能出锅，做法便捷，又能带来充实的饱腹感，一直以来深受稻妻人民的追捧。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Mixed Yakisoba_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 494,
        "name": "奇怪的什锦炒面",
        "desc": "稻妻的家常料理之一。面条与配菜上焦黑的痕迹，暗示着刚刚发生过的惨案。",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/03/14/88072335/cee9db3d94b09e4ae971008ca3f0c859_4858857829391836876.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 1377,
        "name": "美味的什锦炒面",
        "desc": "稻妻的家常料理之一。微卷的面条、寻常的配菜，仿佛被基础的调味料施加上了某种秘术。香滑、弹牙、浓郁…美味如魔法般呈现在了盘中，令人百吃不厌。",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/03/14/88072335/d214dacc547cbbd916f91b5b8d15cf4a_8984815728569781821.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 707,
        "name": "强者之道",
        "desc": "荒泷一斗的特色料理。对方一再强调这是由「荒泷美食大师一斗」亲手组装的「美味到古今无双的料理」。不管站着、坐着、躺着，只要吃下就能填饱肚子，吃完之后就能成为一人之下万人之上的强者…真是多谢他了。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Way of the Strong_icon.png",
        "displayStyle": "card"
      },
