      },
      {
        "type": "CustomEntry",
        "epId": 7366,
        "name": "祭星者之望",
        "desc": "以鹰之形雕刻的造像，烟谜主世代传承的圣物之一。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2024/12/26/de225a286996965268c32027a6c484d9_2367767765928118667.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
        "type": "CustomEntry",
        "epId": 6553,
        "name": "烬城勇者绘卷",
