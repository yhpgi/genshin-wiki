      {
        "type": "CustomEntry",
        "epId": 2741,
        "name": "食谱：薄荷豆汤",
        "desc": "<p>步骤详实的食谱，记载着「薄荷豆汤」的制作方法。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/02/26/88072335/60c9c277139b43907167e6452d409874_3131468015205041697.png",
