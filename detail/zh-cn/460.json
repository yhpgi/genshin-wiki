      },
      {
        "type": "CustomEntry",
        "epId": 460,
        "name": "培根",
        "desc": "经过熏制的肋条兽肉。层次丰富、肥而不腻正是它广受欢迎的原因。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Bacon_icon.png",
