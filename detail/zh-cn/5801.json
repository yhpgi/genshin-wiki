{
  "epId": 5801,
  "name": "珍珠纪行",
  "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2024/06/27/c6c6a89e70780a83a0b41e67e814da53_3543268132760150070.png",
