      },
      {
        "type": "CustomEntry",
        "epId": 2812,
        "name": "妮露",
        "desc": "<p>祖拜尔剧场的知名舞者，舞姿灵动优美 ，为人纯真亲善。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/10/09/36540823/586d726f9ebda3506c78beaaa41f13b6_4307521711219397209.png",
        "amount": 1,
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 2265,
        "name": "提纳里",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.85)\">精通植物学的少年学者，现于道成林任巡林官一职。直率热忱，擅长教导脑瓜糊涂的人。</span></p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/08/23/47826599/d039c6da9285163f46b85f0241f29c17_4850179515894860705.png",
        "amount": 1,
