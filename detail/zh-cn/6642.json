      },
      {
        "type": "CustomEntry",
        "epId": 6546,
        "name": "冲浪时光",
        "desc": "原本预订发放给「第一届全部族冲浪竞速锦标赛」冠军的纪念品。鉴于赛事目前尚处于筹备阶段，奖品便被临时寄存在了「悠游豚豚」内，由店主代为保管。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2024/08/23/6ce2e0da75fbdc19fc4b6f9e7bae9049_5151463723015160354.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
