      },
      {
        "type": "CustomEntry",
        "epId": 3463,
        "name": "迪希雅",
        "desc": "<p>横行须弥沙漠的佣兵组织「镀金旅团」的成员，勇敢而又强大的战士，在「镀金旅团」内部声名赫赫。 </p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/02/27/47826599/65b22311e1e38ffa45a4928d4005ecee_4020951604018642842.png",
        "amount": 1,
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 3336,
        "name": "艾尔海森",
        "desc": "<p>须弥教令院现任书记官，有过人的智慧与才能。生活得自由自在，一般人基本找不到他。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/01/17/47826599/25249dd20b86c775fb35bdbbd805d9ec_8728328065423189518.png",
        "amount": 1,
        "displayStyle": "card"
      },
      {
        "type": "RichText",
        "text": "<color=#ffffff>4★</color>"
      },
      {
        "type": "CustomEntry",
        "epId": 5598,
        "name": "赛索斯",
        "desc": "缄默之殿的继承者。背负着秘密，自沙中而来。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2024/05/30/cdb7abfcb86138e5b618946a5466d442_2702695812908100899.png",
        "displayStyle": "card",
        "menuId": 2
      },
      {
        "type": "CustomEntry",
        "epId": 2967,
        "name": "珐露珊",
        "desc": "<p>来自「一百年前」的学者，喜欢以前辈自居，对各类古老文字与古典机关都颇有研究。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/12/06/47826599/38c12ab46678a4008f83a0e46c900ef5_8882167319536551047.png",
        "amount": 1,
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 2815,
        "name": "坎蒂丝",
        "desc": "<p>有着琥珀色左眼的赤王后裔，阿如村的守护者。</p>",
