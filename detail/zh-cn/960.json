      {
        "type": "CustomEntry",
        "epId": 2750,
        "name": "食谱：日落莓莓茶",
        "desc": "<p>步骤详实的食谱，记载着「日落莓莓茶」的制作方法。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/03/08/88072335/60c9c277139b43907167e6452d409874_8093718390845161953.png",
