      {
        "type": "CustomEntry",
        "epId": 883,
        "name": "日落果",
        "desc": "遍布提瓦特大陆的自然恩惠，如夕阳般靓丽美好的饱满果实。有着奇异的香甜气味，能让人精神百倍。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Sunsettia_icon.png",
        "amount": 3,
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 960,
        "name": "树莓",
        "desc": "颜色鲜艳的果实。遍布野外的小小美好，能将路途疲惫一扫而空。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Berry_icon.png",
        "amount": 3,
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 1328,
        "name": "糖",
        "desc": "提炼自甜甜花的调味剂。它的甜味仿佛有着与人共鸣的力量，能够驱散内心的阴霾。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Sugar_icon.png",
        "amount": 2,
