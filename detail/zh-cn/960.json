      {
        "type": "CustomEntry",
        "epId": 4241,
        "name": "食谱：果果仙酪",
        "desc": "<p>步骤详实的食谱，记载着「果果仙酪」的制作方法。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/09/12/88072335/60c9c277139b43907167e6452d409874_3098879643514990182.png",
