{
  "epId": 6765,
  "name": "食谱：炸虾豆球",
  "desc": "步骤详实的食谱，记载着「炸虾豆球」的制作方法。",
  "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2024/08/26/60c9c277139b43907167e6452d409874_2394618203975894864.png",
