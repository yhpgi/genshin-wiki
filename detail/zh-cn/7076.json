        "alignment": "center"
      },
      {
        "type": "CustomEntry",
        "epId": 3827,
        "name": "斯露莎",
        "desc": "<p>斯露莎是诞生于甘露花海的一只花灵，也是被灵光认可的勇者。</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/11/02/326985891/0f828dc000ea54f3f0ac3bc42eeaa1ea_4255680863916274921.png",
        "displayStyle": "card",
        "menuId": 10
