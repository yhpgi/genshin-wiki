      {
        "type": "CustomEntry",
        "epId": 3825,
        "name": "拉沙鲁",
        "desc": "<p>诞生于甘露花海的一只花灵，拉沙鲁是跋尔松之眷属。</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/07/10/88072335/df8cfccb3616e905b16555813e6b0195_2099326314826445257.png",
