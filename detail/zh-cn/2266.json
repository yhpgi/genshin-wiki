      {
        "type": "CustomEntry",
        "epId": 1722,
        "name": "雾海云间的汞丹",
        "desc": "赋予武器突破之力的材料。<br/>符箓可以让仙人力量借符号残留，外景可以用心像造出宇宙洞天。丹鼎之术，则一直笼罩在秘密之中。毕竟尝试吞下这些金丹的话，结果必定十死无生。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Mist Veiled Mercury Elixir_icon.png",
        "displayStyle": "card",
        "menuId": 9
      },
