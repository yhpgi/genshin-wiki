      {
        "type": "CustomEntry",
        "epId": 123,
        "name": "「浮世」的指引",
        "desc": "天赋培养素材。<br/>雷之国土的梦想是浮世。<br/>浮世之难求乃是人之美的价值所在。人之在世岂不与雷影相似？意欲追逐掇取则遥踞云端，灯火阑珊的静谧之时却不期而来。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Guide to Transience_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 9509,
        "name": "朽裂之庚牌",
        "desc": "残存的木制兵牌，似乎记述着曾在「诀箓阴阳寮」中战斗的武者的名号。<br>在「谜境悬兵」活动中，可以用来换取珍贵的宝物。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/03/04/9477024c76d55224ac7f5a8db94fc186_2232104037118625729.png",
        "amount": 40,
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "RichText",
        "text": "6",
        "alignment": "center"
      },
      {
        "type": "CustomEntry",
        "epId": 122,
        "name": "「浮世」的哲学",
        "desc": "天赋培养素材。<br/>雷之国土的梦想是浮世。<br/>浮世之短暂乃是人之美的本性所在。人之在世岂不与稻光相近？神威显现的刹那恍若隽永，而永恒的威鸣又有谁人能够承受？",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Philosophies of Transience_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 9509,
        "name": "朽裂之庚牌",
        "desc": "残存的木制兵牌，似乎记述着曾在「诀箓阴阳寮」中战斗的武者的名号。<br>在「谜境悬兵」活动中，可以用来换取珍贵的宝物。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/03/04/9477024c76d55224ac7f5a8db94fc186_2232104037118625729.png",
