      {
        "type": "RichText",
        "text": "2",
        "alignment": "center"
      },
      {
        "type": "CustomEntry",
        "epId": 194,
        "name": "「风雅」的指引",
        "desc": "天赋培养素材。<br/>雷之国土的姿容是风雅。<br/>风雅是不倨傲。风雅之人永远是谦虚的。只有消除虚荣与怠慢，才能明亮双眼，从哪怕最不堪入目的表象之下寻求美与雅致的真境。",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Guide to Elegance_icon.png",
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 9509,
        "name": "朽裂之庚牌",
        "desc": "残存的木制兵牌，似乎记述着曾在「诀箓阴阳寮」中战斗的武者的名号。<br>在「谜境悬兵」活动中，可以用来换取珍贵的宝物。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/03/04/9477024c76d55224ac7f5a8db94fc186_2232104037118625729.png",
