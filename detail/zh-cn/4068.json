      {
        "type": "CustomEntry",
        "epId": 7640,
        "name": "香韵奏者",
        "desc": "形制典雅的长枪，据说曾是某位伟大乐师在音律和味觉之间建起桥梁的指挥棒。",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/04/24/f1928d012621b1f03577efc4f619894a_6810995251642628479.png",
        "displayStyle": "card",
        "menuId": 4
      },
      {
