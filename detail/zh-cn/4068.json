      },
      {
        "type": "CustomEntry",
        "epId": 4592,
        "name": "水仙十字之剑",
        "desc": "意志与力量随故事的结束而消褪的长剑，它将要再次踏上新的旅途。其中残余着一些力量，纪念着一场宏大的梦。",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyowiki/2023/12/05/01d3f8317c86ea98d617ad61213b7c9a_3554014463361794070.png",
