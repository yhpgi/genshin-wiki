    "customize": [
      {
        "type": "CustomEntry",
        "epId": 5669,
        "name": "La Hoàn Thâm Cảnh",
        "desc": "<p>La Hoàn Thâm Cảnh là bí cảnh vĩnh viễn với các thử thách được cập nhật liên tục vào ngày 16 hàng tháng. Nó sẽ được mở khoá ở Hạng Mạo Hiểm cấp 20.</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/08/05/12108544/46a8fd965902e8a54ae43c2ed0694526_2815926193778783816.png",
        "displayStyle": "text",
        "menuId": 14
      },
      {
        "type": "CustomEntry",
        "epId": 5670,
        "desc": "",
        "displayStyle": "text"
      },
      {
        "type": "CustomEntry",
        "epId": 5672,
        "name": "Hộp Thánh Vật Thần Bí - Hạng 3",
        "desc": "<p>Hộp Thánh Vật để cất giữ Thánh Di Vật. Mong rằng người nhìn thấy nó sẽ nhận được sự tôn kính.</p><p>Trong mỗi Hộp Thánh Vật, có thể nhận được một trong các bộ Thánh Di Vật sau:</p><p>· “Cuồng Chiến”</p><p>· “Giáo Quan”</p><p>· “Kẻ Lưu Đày”</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/04/29/117208835/c04f785c60063a16c2060c630bf77c22_1500953484990004689.png",
        "displayStyle": "text"
      },
      {
        "type": "RichText",
        "text": "Hoàn thành khiêu chiến <color=#ffe04b>La Hoàn Thâm Cảnh</color> Phòng 3 Tầng 4 - 5\nHoàn thành khiêu chiến <color=#ffe04b>La Hoàn Thâm Cảnh</color> Phòng 2 Tầng 6 - 8\nPhiên bản cũ có thể nhận bằng cách hoàn thành khiên chiến La Hoàn Thâm Cảnh Phòng 1 và 2 của Tầng 9 - 12 (từ 28/09/2020 đến 31/03/2022)"
      },
      {
        "type": "RichText",
        "text": "Trong mỗi Hộp Thánh Vật Huyền Bí - Hạng 2 có thể nhận một Thánh Di Vật 4 sao ngẫu nhiên từ một trong năm bộ Thánh Di Vật. Năm bộ Thánh Di Vật được chọn đã thay đổi qua thời gian"
      },
      {
        "type": "RichText",
        "text": "Ngày\nBộ Thánh Di Vật\n28/09/2020 - 31/03/2022",
        "alignment": "center"
      },
