      {
        "type": "CustomEntry",
        "epId": 3816,
        "name": "EXP Bài Thủ",
        "desc": "<p>Nhận được khi giành chiến thắng ván đấu \"Thất Thánh Triệu Hồi\". Mỗi trận thắng đều sẽ tích lũy phương pháp và cách thức giành chiến thắng, đây cũng chính là thứ được gọi là kinh nghiệm, dù trong tình huống nào đều có thể biết được cách làm thế nào để giành chiến thắng, đó là một điểm mạnh của bài thủ.</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2023/12/15/55631176/a3dfc591cecc908ea00f31c9a3de083f_4076687852305304997.png",
        "amount": 120,
        "displayStyle": "card"
      },
      {
        "type": "CustomEntry",
        "epId": 3333,
