        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7397,
        "name": "Khó Khăn Của Bác Sĩ Saurian",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Bạn bắt gặp một con Qucusaur đang tấn công con người, nhưng hình như có ẩn tình phía sau...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/06/06/44749939/549933d6a6f8b2a27983f9ad268204a7_2799022404558970039.png",
