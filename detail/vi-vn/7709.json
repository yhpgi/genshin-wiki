      },
      {
        "type": "CustomEntry",
        "epId": 7399,
        "name": "Hòn Đảo Cô Độc Tên Là Đêm Đen",
        "desc": "<p><span style=\"color: rgb(255, 255, 255)\">Mọi người phát hiện một căn phòng bí mật được giấu sâu trong Đảo Đêm...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/03/03/297991677/6e9a6f541f74316d186c2d57490675b8_4692519003212260391.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7398,
        "name": "Đá, Dừa Và Kẻ Buôn Saurian",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Tại nơi hẻo lánh gần biên giới Hội Hoa Vũ, một thương nhân lữ hành và người bạn Saurian của anh ấy đang gặp phải phiền phức bí ẩn...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/06/07/44749939/549933d6a6f8b2a27983f9ad268204a7_5478722406002018654.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7396,
        "name": "Tình Bạn Giữa Nước Và Lửa",
        "desc": "<p><span style=\"color: rgb(255, 255, 255)\">Khi đi qua vùng đất phía tây Hội Hoa Vũ, bạn và Paimon phát hiện ra một doanh trại khả nghi. Bất ngờ giải cứu được một con Hải Thú Bồng Bềnh, hình như nó có thể trở thành bạn thân với con Saurian của các bạn...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/03/03/297991677/6e9a6f541f74316d186c2d57490675b8_8677177237587771098.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7708,
        "name": "\"Nóng Bỏng\" Có Thực Sự Hiệu Quả?",
        "desc": "<p>Là \"nóng bỏng\" đã đánh bại \"lạnh giá\", hay là thứ gì khác?</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/04/12/297991677/6e9a6f541f74316d186c2d57490675b8_6865199944879935193.png",
