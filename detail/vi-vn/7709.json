        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 6971,
        "name": "Bóng Hình Của Dãy Núi",
        "desc": "<p>Chuỗi nhiệm vụ thế giới theo chân người kể chuyện Titu trong hành trình điều tra Mũi Kim Bóng Tối.</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/03/09/297991677/b58aa8b101b9400868ae465157aa974a_7395427462157010405.png",
