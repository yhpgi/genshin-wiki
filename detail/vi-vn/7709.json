      },
      {
        "type": "CustomEntry",
        "epId": 6975,
        "name": "Người Truy Vết Không Thể Theo Dấu",
        "desc": "<p>Sâu trong di tích nóng rực, bạn gặp được một cô gái trẻ...</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/03/09/297991677/6e9a6f541f74316d186c2d57490675b8_6842837402393654196.png",
