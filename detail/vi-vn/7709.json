        "displayStyle": "text"
      },
      {
        "type": "CustomEntry",
        "epId": 7005,
        "name": "Hôm Nay Thích Hợp Để Ăn Cá!",
        "desc": "<p>Vì để bạn đồng hành Saurian có cá ăn, lần này Paimon sẽ đi câu cá!</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/04/19/55631176/231826ade1c78996779f1a72e9a57e9e_1948661430940536312.png",
