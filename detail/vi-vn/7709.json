      },
      {
        "type": "CustomEntry",
        "epId": 6966,
        "name": "Giữa Lời Hứa Và Lãng Quên",
        "desc": "<p>Chuỗi nhiệm vụ thế giới theo chân Cậu Nhóc, một chú Tepetlisaurus nhỏ đã nhận được <custom-ruby data-ruby=\"Phước Lành Lửa Thánh|Xiuhcoat\"></custom-ruby>.</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/02/04/44749939/2f00e2412e12fb7f69d0613ddd247314_5503421853762086547.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 6967,
        "name": "Đứa Con Lạc Rừng",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Lần đầu đến Natlan, bạn đã bị dịch chuyển đến một không gian kỳ lạ...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/02/04/44749939/549933d6a6f8b2a27983f9ad268204a7_809162983851353689.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 6968,
        "name": "Nghi Thức Của Người Dũng Cảm",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Đến bộ tộc Con Của Tiếng Vang, tìm kiếm manh mối tín vật núi lửa nào</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/02/06/44749939/549933d6a6f8b2a27983f9ad268204a7_3954892220014818929.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 6969,
        "name": "Tiết Lộ Từ Quá Khứ",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Bạn đã được Pacal cho phép hành hương đến núi lửa. Hãy lên đường cùng Cậu Nhóc sau khi bạn hoàn tất khâu chuẩn bị.</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/02/06/44749939/549933d6a6f8b2a27983f9ad268204a7_6508506607284180650.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7379,
        "name": "Lữ Khách Lạc Lối Trong Vương Quốc Tro Bụi",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Để theo đuổi giấc mơ vĩ đại giữa sương sớm và biển mây, các chiến binh bay lượn chưa bao giờ ngơi nghỉ.<br>Sâu trong biển sương xa xôi, câu chuyện về con rồng độc ác chiếm cứ thành phố bỏ hoang vẫn đang bảo vệ điều cấm kỵ; Mà trên những tầng mây, con thuyền trống trải huyền thoại bị lãng quên cũng sẽ chào đón vị khách mới ghé thăm...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/06/11/44749939/5433a63629b7292b6fe285f6622edec2_2224825912814683588.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7381,
        "name": "Vượt Qua Bức Tường Sương Mù",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Để tìm kiếm báu vật mang tên Mảnh Ngọc Quay Về, cũng như để truy tìm dấu vết của con ác long, các bạn đã bước vào khu di tích cổ được coi là cấm địa...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/06/11/44749939/549933d6a6f8b2a27983f9ad268204a7_7728987746265082257.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7383,
        "name": "Cuộc Phiêu Lưu Ở Vương Quốc Sương Mù",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Sau khi đánh bại con rồng độc ác, các bạn cùng Bona, người tự xưng là nhà mạo hiểm và Coco bí ẩn đã bắt đầu hành trình tìm kiếm Tonatiuh và Mảnh Ngọc Quay Về...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/06/11/44749939/549933d6a6f8b2a27983f9ad268204a7_8951201907096134239.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7384,
        "name": "Cung Điện Của Ảo Xà",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Dưới sự dẫn dắt của Coco, các bạn đã đến di tích cung điện ở tầng trên Ochkanatlan. Có vẻ như bên dưới di tích ẩn giấu điều gì đó...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/06/11/44749939/549933d6a6f8b2a27983f9ad268204a7_6497457720391497673.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7385,
        "name": "Khởi Hành Lên Trời",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Sau khi có được hai mảnh Hỏa Lân Thạch, con đường dẫn lên bầu trời cuối cùng cũng đã mở ra...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/06/12/44749939/549933d6a6f8b2a27983f9ad268204a7_3691445327867236413.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7388,
        "name": "Phía Bên Kia Bầu Trời",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Băng qua những tầng mây, cuối cùng các bạn cũng đã đến được Tonatiuh huyền thoại...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/06/12/44749939/549933d6a6f8b2a27983f9ad268204a7_6220472994355462917.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7389,
        "name": "Thời Khắc Tỉnh Mộng",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Để lấy lại Mảnh Ngọc Quay Về, các bạn đã đuổi theo con rồng độc ác đó...</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/06/12/44749939/549933d6a6f8b2a27983f9ad268204a7_1461633317894502426.png",
        "displayStyle": "text",
        "menuId": 31
      },
      {
        "type": "CustomEntry",
        "epId": 7390,
