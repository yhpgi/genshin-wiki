      {
        "type": "RichText",
        "text": "Vahumana",
        "alignment": "center"
      },
      {
        "type": "CustomImage",
        "url": "https:/act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/01/10/297991677/bc519360854209a4434398131554ed2e_4233476774928474311.png",
        "alignment": "left"
      },
      {
        "type": "RichText",
        "text": "Căn nguyên học, lịch sử học, xã hội học và ngữ nghĩa học.\nIskandar",
        "alignment": "center"
      },
      {
        "type": "CustomEntry",
        "epId": 2968,
        "name": "Kẻ Lang Thang",
        "desc": "<p>Một kẻ lang thang thân phận huyền bí. Trang phục trông như người khổ hạnh, nhưng cách nói chuyện thì lại không giống như vậy.</p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/12/07/148664880/24d97a22be742fb732ea96f625d1faac_2147655785111422423.png",
        "displayStyle": "text",
        "menuId": 2
      },
      {
        "type": "CustomEntry",
        "epId": 3447,
        "name": "Tirzad",
        "desc": "",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2023/03/26/44749939/4530f70f4eea2094b2667224888238f7_2503579044948921817.png",
        "displayStyle": "text",
        "menuId": 10
      },
      {
        "type": "RichText",
        "text": "Siraj\nSachin\nVikram\nSoheil\nHội Hoài Nghi\n(tách ra từ Akademiya khoảng 500 năm trước)\nLịch sử và di sản\nNagarjuna\nNasejuna\nPyrrho",
        "alignment": "center"
      },
      {
        "type": "Heading",
        "level": 3,
        "text": "Lễ Hội"
      },
      {
        "type": "CustomEntry",
        "epId": 7032,
        "name": "Lễ Hội Sabzeruz",
        "desc": "<p><span style=\"color: oklab(0.899401 -0.00192499 -0.00481987)\">Lễ hội ở Sumeru được đặt theo tên của Hoa Thần và kỷ niệm ngày sinh của Thảo Thần.</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/10/01/44749939/bef90833a4b22d42eb98d73aa66789c5_8296248157476584124.png",
        "displayStyle": "card",
        "menuId": 20
      },
      {
        "type": "RichText",
        "text": "Lễ kỷ niệm ngày sinh của Thảo Thần, do Giáo Viện Sumeru tổ chức.\nĐại Hội Akademiya\nSự kiện quy mô lớn do Giáo Viện tổ chức, bao gồm: Điển Lễ Trí Tuệ và Học Viện Tranh Bá.",
        "alignment": "center"
      }
