{
  "epId": 5858,
  "name": "Chourei",
  "desc": "<p><span style=\"color: rgba(255,255,255,0.65)\">Một Melusine có nhiệm vụ duy trì trật tự tại cảng.</span></p>",
  "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/10/02/44749939/8e7b92e0fde945ec99d6db0c74a81672_3635798862648354207.png",
