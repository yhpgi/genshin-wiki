        "name": "Canon",
        "desc": "<p>Nữ Thần Sương Nguyệt</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/12/297991677/62fa3dc49883764886c642a2ff2d5cdd_7314346848131244457.png",
        "displayStyle": "card"
