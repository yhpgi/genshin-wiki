        "menuId": 12
      },
      {
        "type": "CustomEntry",
        "epId": 8836,
        "name": "Kính Dệt Màn Đêm",
        "desc": "Tấm gương sáng bằng bạc không tì vết, tương truyền đã chứng kiến sự ra đời của Thiếu Nữ Mặt Trăng, vì thế mà được Dòng Dõi Sương Nguyệt xem như thánh vật tối cao.",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/09/01/d28b849e0abef976114ea7ecef92960e_4616051474368823347.png",
