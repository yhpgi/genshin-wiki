      },
      {
        "type": "CustomEntry",
        "epId": 2930,
        "name": "Câu Chuyện Về Mục Đồng Và Bình Ma",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Câu chuyện về một cậu bé chăn cừu tình cờ gặp một chiếc bình bạc trên sa mạc và vị khách không mời bị giam cầm trong đó.</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/01/15/44749939/9de03db256112612399b77ee0e83b615_448018889617541341.png",
        "displayStyle": "card",
        "menuId": 12
      },
      {
        "type": "CustomEntry",
        "epId": 2924,
        "name": "Câu Chuyện Về Shiruyeh Và Shirin",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.65)\">Trong gió đêm, Trấn Linh kể câu chuyện về cậu bé chăn cừu. Đó là một câu chuyện không rõ nguồn gốc và đầy vô lý.</span></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2024/01/15/44749939/f5ae53f4b2bce42357d1d9143add7ad4_3528978008670138115.png",
