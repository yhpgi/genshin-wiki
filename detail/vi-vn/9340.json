      {
        "type": "CustomEntry",
        "epId": 2668,
        "name": "Quán Nguyệt Thương",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.85)\">Vũ khí nhận được từ câu chuyện của Aranara. Có tạo hình của mũi tên khổng lồ, được dùng như mũi thương sắc bén.</span></p>",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/08/27/148664880/2fd4c21eb183adb937557401b69f56e0_3651845437964156144.png",
