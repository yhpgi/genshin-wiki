        "epId": 7144,
        "name": "Suối Ẩn Trong Ngọc",
        "desc": "<p><span style=\"color: rgba(255, 255, 255, 0.45)\">Thanh niên lạc lối tại rừng trúc trong thung lũng, sẽ gặp những người qua đường như thế nào đây?</span></p>",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2024/11/14/26abaed96f198252c20ded9a16ce7d4e_3939073526739800803.png",
