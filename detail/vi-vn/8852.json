      {
        "type": "RichText",
        "text": ".\n<color=#ffffff>Vị trí</color> <color=#ffffffd9>–</color> <color=#ebe4d8>Hành Lang Trống, Nod-krai</color>"
      },
      {
        "type": "CustomImage",
