        "name": "Zurvan",
        "desc": "<p>Pari Đầu Tiên</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/24/15884296/0987bc70b51b17406a88efddf714172b_4321716580422842199.png",
        "displayStyle": "card"
