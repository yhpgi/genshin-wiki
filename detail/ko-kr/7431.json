        "epId": 7707,
        "name": "달리아",
        "desc": "페보니우스 성당의 부제이자 바람 신의 대행자",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/06/16/255dedc5048565aec2c5af510c6f74a5_7726536808309970424.png",
