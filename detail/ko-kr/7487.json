        "name": "「교부 코반」",
        "desc": "<p></p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2025/04/08/302875544/0caf81975a271a5b230198f54ecb39ef_2671837484152796010.png",
