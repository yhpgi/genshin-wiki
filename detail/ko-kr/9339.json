        "name": "시루이와 시린의 이야기",
        "desc": "",
        "iconUrl": "https://upload-static.hoyoverse.com/hoyolab-wiki/2022/10/12/194600931/1cf52e4ba9a7722762b61b5c22d7b42d_3696658599726082521.png",
