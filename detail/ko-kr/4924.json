      {
        "type": "CustomEntry",
        "epId": 606,
        "name": "엔도라",
        "desc": "호기심 많은 물의 정령, 단지 세상을 보고 싶어 한다. 「작은 선령·노초」와 잘 맞을지도 모른다. 그렇다고 융합해버리진 말자",
        "iconUrl": "https://bbs.hoyolab.com/hoyowiki/picture/object/Endora_icon.png",
