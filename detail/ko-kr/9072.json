          {
            "type": "CustomEntry",
            "epId": 7624,
            "name": "에스코피에",
            "desc": "폰타인에서 명성이 자자한 드보르 호텔 전 주방장. 「디저트 대령」이라는 칭호를 가진 「과학 요리」의 선구자로, 요리에 대한 기준이 매우 엄격하다",
            "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/04/30/ddbc128157d69479f61747f0918f9e72_2470321636402108639.png"
          }
        ],
