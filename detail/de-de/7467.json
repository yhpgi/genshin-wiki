  "epId": 7467,
  "name": "Paimon",
  "desc": "<p>Die beste Freundin des/der Reisenden und Teyvat-Führerin.</p>",
  "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/03/38772802/03dba4da579ab5b8b961694be289266d_1636025536145527630.png",
