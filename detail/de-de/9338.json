      {
        "type": "CustomEntry",
        "epId": 7489,
        "name": "Nibelung",
        "desc": "<p>Der Anführer der elementaren Drachen und der Urschöpfer von Teyvat.</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/03/19/38772802/596896f7ea3d51d7b1f6e504094f9d97_8832436280303618146.png",
        "displayStyle": "card"
      },
      {
        "type": "RichText",
        "text": "Der urzeitliche Drache schuf drei Mondgöttinnen und die drei Monde und hob sie in den Himmel. Während dem"
      },
      {
        "type": "CustomEntry",
        "epId": 9095,
        "desc": "",
        "displayStyle": "text"
      },
      {
        "type": "RichText",
        "text": "sperrte Nibelung die drei Mondgöttinnen ein und verwandelte ihre Monde in Waffen."
      },
      {
        "type": "CustomEntry",
        "epId": 7625,
        "desc": "",
        "displayStyle": "card"
      },
      {
        "type": "RichText",
        "text": "Arya ist die Göttin des Ewigen Mondes <color=#9b9c9f>–</color> der größte der drei Monde. Ihre Macht führte zu den Gezeiten des Ozeans."
      },
      {
        "type": "RichText",
        "text": "Mondmark",
        "alignment": "center"
      },
      {
        "type": "RichText",
        "text": "Die Ewige Mondscherbe, die Aryas Kräfte enthält. Die Mondkantorin"
      },
      {
        "type": "CustomEntry",
        "epId": 8396,
        "name": "Lauma",
        "desc": "Die vom Mondlicht und Wald gesegnete hehre Jungfer, die inmitten der Nachkommen des Frostmonds geborene Hoffnung.",
