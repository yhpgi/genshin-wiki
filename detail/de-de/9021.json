    "talent": [
      {
        "title": "Schwertkunst fremder Regionen – Wachsamkeit",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2025/10/28/94aa30ae75b8c7c6a9c64ab05bd5dda7_1164987306122115041.png",
        "desc": [
          {
            "type": "RichText",
            "text": "<color=#ffd780>Standardangriff</color>\nFührt bis zu 4 Schwerthiebe hintereinander aus.\n<color=#ffd780>Heftiger Schlag</color>\nVerbraucht eine gewisse Menge Ausdauer und schwingt das Schwert zweimal schnell nach vorn.\n<color=#ffd780>Angriff aus dem Fall</color>\nSchlägt beim Fallen aus der Luft auf den Boden, greift alle Gegner in der Bahn an und verursacht beim Aufkommen Flächenschaden."
          }
        ],
