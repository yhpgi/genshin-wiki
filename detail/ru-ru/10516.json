        "menuId": 10
      },
      {
        "type": "CustomEntry",
        "epId": 10615,
        "name": "Цайтлинд",
        "desc": "<p>Девушка, расследующая исчезновение своей сестры Ромхильды в санатории на Пике ветров.</p>",
        "iconUrl": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/04/11/237301566/3f0d85f59589c6eb4033b66a578e594e_6054625020419889632.png",
