      {
        "type": "CustomEntry",
        "epId": 11334,
        "name": "Снежноцвет",
        "desc": "Очаровательный цветок с шаровидным соцветием. Под снегом он становится похож на маленький снежок.",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/08/03/b010f537a47f707e7b70baded9f4e591_6099634129849598493.png",
        "displayStyle": "card",
        "menuId": 9
      },
      {
        "type": "CustomEntry",
        "epId": 11335,
        "name": "Смородина",
        "desc": "Ароматная ягода, растущая на покрытых инеем ледяных ветвях.",
        "iconUrl": "https://act-webstatic.hoyoverse.com/event-static-hoyowiki-admin/2026/08/03/2b0b12818802fddfaf60a8614db64aa3_313468438961115022.png",
        "displayStyle": "card",
        "menuId": 9
      },
      {
