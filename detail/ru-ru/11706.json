    "galleryCharacter": [
      {
        "key": "Деревня в приграничье",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/08/20/237301566/c3359932b9b7dc7d7f9545b1e114d179_8165176629469549030.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Деревня, процветавшая в эпоху освоения. Когда-то через неё нескончаемым потоком проходили путники, курсировавшие между Снежной и Нод-Краем."
          }
        ]
      },
      {
        "key": "Там, где вновь восходит заря",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/08/20/237301566/db58412ede29c2203e0b9be1b3fc248c_1726794968719255851.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Даже в самую холодную ночь находятся те, кто идёт сквозь метель. Их ведёт лишь одна надежда - увидеть светлое и сияющее завтра."
          }
        ]
      }
    ],
