    "galleryCharacter": [
      {
        "key": "Поместье в снежных горах",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/08/20/237301566/a2774bc9c456ae5d7c50c9ba5cb631bf_2144108509103938178.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Когда-то это закрытое ныне поместье принадлежало прославленному великому князю снеговиков. Чьи сокровенные чувства и мрачные тайны покоятся за его безмолвными ледяными стенами?"
          }
        ]
      },
      {
        "key": "Скрытое поселение альвов",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/08/20/237301566/ad3e7b0dd740ce79aac3b7c6a8691326_369935501986482248.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Говорят, если увидишь на снежной равнине безостановочно катящийся снежный ком и последуешь за ним, он приведёт тебя сюда."
          }
        ]
      },
      {
        "key": "Пещера поющих приливов",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/08/20/237301566/e29cb9a353f9f497d804a492dee95749_3138341558974839926.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Приливные волны мягко набегают на скалистый берег в такт мелодии, которую напевает певица. В этом пустынном и одиноком месте, быть может, лишь морские волны и печальное эхо способны подарить ей редкое спокойствие."
          }
        ]
      }
    ],
