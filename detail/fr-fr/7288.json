    "galleryCharacter": [
      {
        "key": "Effondrement de la tour blanche",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/23/170542231/0ef5312f8a17422c05ea81caa33bc56b_2972459256739301388.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Idéaux, illusions, ressentiments et espoirs : à la fin, la tour construite pour répondre aux souhaits du peuple s'est également effondrée lorsque ces souhaits ont été brisés..."
          }
        ]
      },
      {
        "key": "Ville de cendres inachevée",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/23/170542231/d88142d20262e28efd07f44f612bdf19_4607563808861981574.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Sur les ruines d'une cité bâtie par une race oubliée, des hommes ont tenté de construire une nouvelle nation. Aujourd'hui, il ne reste plus que les cendres de l'incendie, et l'alliance qui s'était réunie à cette fin s'est depuis longtemps dispersée..."
          }
        ]
      },
      {
        "key": "Centre de contrôle de la lignée",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/23/170542231/a804f561810a92920794c3d1e4fe7aeb_5416182429815625215.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Pour enterrer l'ineffable passé et dévoiler l'avenir de sa lignée, quelqu'un a un jour offert son propre cœur comme vaisseau qui contrôlerait toute la ville. Après ce jour au cours duquel même les âmes des montagnes ont été réduites en cendres, qui veille sur la cité ?"
          }
        ]
      },
      {
        "key": "Ancien cœur de Chu'ulel",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/23/170542231/314fe5f8774f114636ee26e977826e6c_3321693348748147475.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Dans les vestiges de la ville désormais considérée comme en ruines, une ancienne race a forgé une sagesse sans corps en utilisant des commandes et des dessins dorés et l'a stockée dans des statues de pierre afin de contrôler les mécanismes de la ville entière."
          }
        ]
      },
      {
        "key": "Satellite flottant parmi les nuages",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/23/170542231/ce09390d930da9043947daa9ca919ed5_2583450853391116449.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "On ne sait pas pourquoi il a été enseveli dans l'océan de nuages, ni pourquoi le vaisseau s'est arrêté ici. Bien qu'il ait échappé au contrôle de son créateur, il continue à garder un ancien secret."
          }
        ]
      },
