    "galleryCharacter": [
      {
        "key": "Les belles légendes de Petrichor",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/02/170542231/c521e0a890620a200f2d582cbb12c015_4548191139715474558.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "Il existe de nombreuses légendes belles et émouvantes sur Petrichor, mais aucune d'entre elles n'a changé la vie dans le petit village.\nChaque fois que la brise marine emporte le son de la cloche du soir, les habitants savent qu'une autre journée tranquille vient de s'écouler."
          }
        ]
      },
      {
        "key": "La scène de l'or fané",
        "img": "https://act-upload.hoyoverse.com/event-ugc-hoyowiki/2026/02/02/170542231/941a93d1e73422b0cc7b507a4852174d_3099149817810618602.png",
        "imgDesc": [
          {
            "type": "RichText",
            "text": "À la fin de toute la renommée et la splendeur, le chef d'orchestre dépourvu de musique se lamentait autrefois sur un passé qui ne pourrait jamais revenir."
          }
        ]
      },
      {
        "key": "Lieu mystérieux de l'ordre ancien",
